# Copy this file to lightdash/.env for local runs.
# Do not reuse these example values in Cloud Run.

LIGHTDASH_IMAGE=lightdash/lightdash:2.17.0
PORT=8080
SITE_URL=http://localhost:8080

# Local Lightdash metadata database.
PGHOST=db
PGPORT=5432
PGUSER=lightdash
PGPASSWORD=local-lightdash-password
PGDATABASE=lightdash

# Local-only application secret. Use Secret Manager for Cloud Run.
LIGHTDASH_SECRET=local-lightdash-secret-change-me

SECURE_COOKIES=false
TRUST_PROXY=false
ALLOW_MULTIPLE_ORGS=false
SCHEDULER_ENABLED=true
GROUPS_ENABLED=true

# Local S3-compatible object storage for Lightdash files/results.
MINIO_ROOT_USER=lightdash
MINIO_ROOT_PASSWORD=local-minio-password
S3_ENDPOINT=http://minio:9000
S3_BUCKET=lightdash
S3_REGION=us-east-1
S3_ACCESS_KEY=lightdash
S3_SECRET_KEY=local-minio-password
S3_FORCE_PATH_STYLE=true
